{
  "name": "recipe-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "server": "npm run dev --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web": "npm run web --workspace apps/mobile",
    "build:web": "npm run export --workspace apps/mobile"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
