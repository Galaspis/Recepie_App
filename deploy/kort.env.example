# Copy to kort.env on the VPS (/srv/kort/kort.env). Never in git.
DATABASE_URL=postgres://kort:PASSWORD-FROM-pg.env@kort-db:5432/kort
MEDIA_DIR=/media
MEDIA_BASE_URL=/media
HUB_AUTH=1
# Only these accounts may use Kort (comma-separated emails).
KORT_ALLOWED_EMAILS=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Optional
OPENAI_API_KEY=
COOKIES_FILE=
SCRAPECREATORS_API_KEY=
UNSPLASH_ACCESS_KEY=
